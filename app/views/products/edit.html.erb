<div class="flex flex-col w-[90%] max-w-2xl">
  <%= render 'form', product: @product, message: 'Editar producto' %>
  <% if @product.category %>
    <%= link_to "Atrás", control_panel_path(filter: @product.category.category_type), class: 'underline underline-blue-800 text-blue-600' %>
  <% else %>
    <%= link_to "Atrás", special_menus_path, class: 'underline underline-blue-800 text-blue-600' %>
  <% end %>
</div>
